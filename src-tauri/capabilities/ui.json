{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "Capability for the trusted UI webviews",
  "windows": ["main", "print"],
  "webviews": ["ui", "print"],
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "opener:default"
  ]
}
